# ============================================
# STEELCONTROL - PRODUÇÃO
# ============================================
NODE_ENV=production
PORT=3000

# URL fornecida pelo PostgreSQL gerenciado (Render/Neon/Railway/Supabase)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require"

# Gere uma nova chave para produção. NÃO reutilize a chave de desenvolvimento.
JWT_SECRET="COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_LONGA_COM_64_CARACTERES_OU_MAIS"
JWT_EXPIRES_IN="8h"

EMAIL_USER="steelcontrol@seu-dominio-ou-gmail.com"
EMAIL_APP_PASSWORD="SENHA_DE_APP"
EMAIL_FROM="SteelControl <steelcontrol@seu-dominio-ou-gmail.com>"

# URL da Face API hospedada
FACE_API_URL="https://SUA-FACE-API.exemplo.com"
FACE_API_KEY="MESMA_CHAVE_FORTE_CONFIGURADA_NA_FACE_API_COM_32_OU_MAIS_CARACTERES"
FACE_API_TIMEOUT_MS=60000

# Pode ficar vazio se o frontend for servido pelo próprio backend.
# Adicione aqui domínios extras separados por vírgula se necessário.
CORS_ORIGINS=""

DEVICE_COMMAND_LEASE_MS=15000

# Descoberta automática de equipamentos na rede local
DISCOVERY_ENABLED=true
DISCOVERY_PORT=4210
# Opcional: URL que os dispositivos devem usar para falar com a API.
# Em rede local pode ficar vazio; o backend escolhe o IP LAN automaticamente.
DISCOVERY_ADVERTISE_URL=""
