# ============================================
# STEELCONTROL - BACKEND
# ============================================
# Nunca versione o arquivo .env real.

PORT=3000
NODE_ENV=development

# PostgreSQL local (desenvolvimento)
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/steelcontrol_enterprise?schema=public"

# Gere uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-com-32-ou-mais-caracteres"
JWT_EXPIRES_IN="8h"

# Gmail SMTP / Nodemailer
EMAIL_USER="seu-email@gmail.com"
EMAIL_APP_PASSWORD="senha-de-app-do-google"
EMAIL_FROM="SteelControl <seu-email@gmail.com>"

# Face API local
FACE_API_URL="http://127.0.0.1:8000"
FACE_API_KEY="chave-local-opcional-com-32-caracteres-ou-mais"
FACE_API_TIMEOUT_MS=60000

# Só é necessário quando outro domínio acessa a API.
# O frontend servido pelo próprio backend é autorizado automaticamente.
CORS_ORIGINS="http://127.0.0.1:5500,http://localhost:5500"

DEVICE_COMMAND_LEASE_MS=15000
