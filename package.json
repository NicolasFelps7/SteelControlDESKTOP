{
  "name": "steelcontrol-tcc",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "npm --prefix backend ci --include=dev && npm --prefix backend run prisma:generate",
    "start": "npm --prefix backend run start:prod",
