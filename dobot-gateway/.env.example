# SteelControl Dobot Gateway
STEELCONTROL_URL=http://127.0.0.1:3000
MACHINE_ID=1
DEVICE_KEY=cole-a-device-key-da-maquina

# mock = funciona sem Dobot / real = USB/serial real
DOBOT_MODE=mock
DOBOT_PORT=AUTO
DOBOT_BAUD=115200
DOBOT_INTERVAL_MS=1000

# Segurança: mantenha false até testar leitura do braço físico.
DOBOT_ALLOW_MOTION=false
