# Em desenvolvimento pode usar as origens locais abaixo.
# Em produção o navegador não acessa esta API diretamente: o Node faz proxy.
FACE_CORS_ORIGINS="http://127.0.0.1:5500,http://localhost:5500"

# Use a MESMA chave em backend/FACE_API_KEY.
# Em produção gere uma chave aleatória longa.
FACE_API_KEY="chave-local-opcional-com-32-caracteres-ou-mais"
